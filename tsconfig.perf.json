{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "#iink": [
        "./dist/iink.d.ts"
      ]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "test/perf",
    "test/perf-e2e",
    "test/examples/helper.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
