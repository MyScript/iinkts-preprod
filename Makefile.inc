
REGISTRY := registry.corp.myscript.com:5000
WITH_NETWORK ?= true
GIT_BRANCH = $(shell git rev-parse --abbrev-ref HEAD)
BUILDID ?= $(shell echo "dev-$(GIT_BRANCH)"|sed 's/[_\/\.]/-/g'|cut -c '1-32')
CURRENT_PWD := $(shell pwd)

DOCKER_REPOSITORY_MONGO := mongo
DOCKER_REPOSITORY_IINK_SCRIPTS := $(REGISTRY)/iink-ts-scripts
DOCKER_REPOSITORY_IINK_EXAMPLES := $(REGISTRY)/iink-ts-examples
DOCKER_REPOSITORY_IINK_RESOURCES_MYSCRYPT = $(REGISTRY)/iink-resources
DOCKER_REPOSITORY_IINK_FONTS = $(REGISTRY)/googlefonts
DOCKER_REPOSITORY_IINK_LICENSES = $(REGISTRY)/iink-license
DOCKER_REPOSITORY_IINK_BACKEND := $(REGISTRY)/iink-backend
DOCKER_REPOSITORY_WAIT_TCP := $(REGISTRY)/iink-ts-wait-tcp
DOCKER_REPOSITORY_JEST := $(REGISTRY)/iink-ts-jest
DOCKER_REPOSITORY_PLAYWRIGHT := mcr.microsoft.com/playwright

DOCKER_TAG_IINK_FONTS := 20220922-00
DOCKER_TAG_IINK_RESOURCES_MYSCRYPT := latest
DOCKER_TAG_IINK_LICENSES := latest
DOCKER_TAG_IINK_BACKEND := latest
## in mongo 5.0 mongo --replSet not work
DOCKER_TAG_MONGO := 4.4
DOCKER_TAG_WAIT_TCP := 1.0.0
DOCKER_TAG_JEST := 1.0.0
DOCKER_TAG_PLAYWRIGHT := v1.49.0-jammy

DOCKER_TAG_IINK_SCRIPTS := 1.0.0
DOCKER_TAG_IINK_EXAMPLES := 1.0.0

APPLICATION_KEY := 7d223f9e-a3cb-4213-ba4b-85e930605f8b
HMAC_KEY := 5ab1935e-529a-4d48-a695-158450e52b13
EXAMPLES_LISTEN_PORT := 80

ifeq ($(WITH_NETWORK),false)
	DOCKER_PREFIX := iink-ts-local-$(BUILDID)

	NETWORK_PARAM := --network host
	NETWORK_ALIAS_EXAMPLES := localhost
	NETWORK_ALIAS_MONGO := localhost
	NETWORK_ALIAS_IINK_BACKEND := localhost
else
	DOCKER_PREFIX := iink-ts-ci-$(BUILDID)

	NETWORK_NAME := $(DOCKER_PREFIX)

	NETWORK_PARAM := --network $(NETWORK_NAME)
	NETWORK_ALIAS_EXAMPLES := iink-examples
	NETWORK_ALIAS_MONGO := mongo
	NETWORK_ALIAS_IINK_BACKEND := iink-backend

	NETWORK_ALIAS_EXAMPLES_PARAM := --network-alias $(NETWORK_ALIAS_EXAMPLES)
	NETWORK_ALIAS_MONGO_PARAM := --network-alias $(NETWORK_ALIAS_MONGO)
	NETWORK_ALIAS_IINK_BACKEND_PARAM := --network-alias $(NETWORK_ALIAS_IINK_BACKEND)
endif

DOCKER_MONGO_REPLICATSET := $(DOCKER_PREFIX)-mongo-replicatset


##########
# IMAGES #
##########
DOCKER_IMAGE_MONGO := $(DOCKER_REPOSITORY_MONGO):$(DOCKER_TAG_MONGO)
DOCKER_IMAGE_IINK_SCRIPTS := $(DOCKER_REPOSITORY_IINK_SCRIPTS):$(DOCKER_TAG_IINK_SCRIPTS)
DOCKER_IMAGE_IINK_RESOURCES_MYSCRYPT = $(DOCKER_REPOSITORY_IINK_RESOURCES_MYSCRYPT):$(DOCKER_TAG_IINK_RESOURCES_MYSCRYPT)
DOCKER_IMAGE_IINK_FONTS = $(DOCKER_REPOSITORY_IINK_FONTS):$(DOCKER_TAG_IINK_FONTS)
DOCKER_IMAGE_IINK_LICENSES = $(DOCKER_REPOSITORY_IINK_LICENSES):$(DOCKER_TAG_IINK_LICENSES)
DOCKER_IMAGE_IINK_BACKEND = $(DOCKER_REPOSITORY_IINK_BACKEND):$(DOCKER_TAG_IINK_BACKEND)
DOCKER_IMAGE_IINK_EXAMPLES = $(DOCKER_REPOSITORY_IINK_EXAMPLES):$(DOCKER_TAG_IINK_EXAMPLES)

DOCKER_IMAGE_WAIT_TCP = $(DOCKER_REPOSITORY_WAIT_TCP):$(DOCKER_TAG_WAIT_TCP)
DOCKER_IMAGE_JEST := $(DOCKER_REPOSITORY_JEST):$(DOCKER_TAG_JEST)
DOCKER_IMAGE_PLAYWRIGHT := $(DOCKER_REPOSITORY_PLAYWRIGHT):$(DOCKER_TAG_PLAYWRIGHT)

#############
# INSTANCES #
#############
DOCKER_INSTANCE_MONGO := $(DOCKER_PREFIX)-mongo
DOCKER_INSTANCE_IINK_SCRIPTS := $(DOCKER_PREFIX)-iink-scripts
DOCKER_INSTANCE_IINK_FONTS := $(DOCKER_PREFIX)-iink-fonts
DOCKER_INSTANCE_IINK_LICENSES := $(DOCKER_PREFIX)-iink-license-volume
DOCKER_INSTANCE_IINK_RESOURCES := $(DOCKER_PREFIX)-iink-resources
DOCKER_INSTANCE_IINK_BACKEND := $(DOCKER_PREFIX)-iink-backend
DOCKER_INSTANCE_IINK_EXAMPLES := $(DOCKER_PREFIX)-examples
DOCKER_INSTANCE_PLAYWRIGHT := $(shell echo "$(DOCKER_PREFIX)-playwright-$(PROJECT)" | tr "[:upper:]" "[:lower:]" | tr " " "-")
