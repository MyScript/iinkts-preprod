{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./",
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `test/perf` is excluded below: it imports `#iink`, which needs `dist/` built, and uses `.ts`
  // import specifiers. These two modules are the exceptions — the gate's decision rule and its
  // statistics are deliberately import-free precisely so the main project can check and unit-test
  // them. `exclude` does not filter `files`, so listing them here is what makes
  // `test/unit/perf/*.test.ts` type-check.
  "files": [
    "test/perf/lib/gate.ts",
    "test/perf/lib/stats.ts"
  ],
  "include": [
    "src",
    "test",
    "config",
    "examples/**/*.ts",
    "./eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test/perf",
    "examples/custom-rendering/tldraw-websocket-client"
  ]
}
